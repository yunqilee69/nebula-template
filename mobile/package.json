{
  "name": "@nebula/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "NEBULA 移动端基座（React Native 新架构 + RNOH，一套代码输出 iOS / Android / 鸿蒙）。框架层，不含业务页面。",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ohos": "react-native run-harmony",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@nebula/client-sdk": "file:../packages/client-sdk",
    "@react-native-oh-tpl/react-native-safe-area-context": "^4.7.4-0.2.1",
    "@react-native-oh/react-native-harmony": "^0.77.75",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "react": "18.3.1",
    "react-native": "0.77.1",
    "react-native-keychain": "9.2.3",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.77.1",
    "@react-native/metro-config": "0.77.1",
    "@types/react": "^18.3.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
