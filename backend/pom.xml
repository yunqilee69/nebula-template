<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Nebula 后端模板工程：独立于主仓 reactor，只依赖发布到 Maven Central 的
        cn.cloudomni:nebula-app-starter。fork nebula-template 仓库后：
        1. 修改 groupId / artifactId 为你自己的项目坐标
        2. docker compose up -d 启动 MySQL + Redis（首次自动导入初始化 SQL）
        3. mvn spring-boot:run
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>cn.cloudomni</groupId>
    <artifactId>nebula-template-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>nebula-template-backend</name>
    <description>Nebula 中台后端模板工程（基于 nebula-app-starter）</description>

    <properties>
        <java.version>21</java.version>
        <!--
            框架版本：与主仓发布到 Maven Central 的版本保持一致。
            nebula 主仓打 v* 标签发布时，sync-template 工作流会按标签版本覆盖本值，
            因此本文件在主干上始终指向“当前最新已发布版本”，勿手工填未发布版本。
        -->
        <nebula.version>0.2.3</nebula.version>
        <!--
            MapStruct 处理器版本：须与框架传递的 mapstruct 运行时版本保持一致
            （见 nebula-dependency 的 mapstruct.version），否则处理器生成的代码
            可能与运行时 API 不匹配。
        -->
        <mapstruct.version>1.6.0</mapstruct.version>
    </properties>

    <dependencies>
        <!-- 一个依赖获得完整中台后端：认证/字典/参数/通知/存储/审计/调度/前端配置 -->
        <dependency>
            <groupId>cn.cloudomni</groupId>
            <artifactId>nebula-app-starter</artifactId>
            <version>${nebula.version}</version>
        </dependency>
        <!--
            业务代码使用 Lombok（实体/DTO 的 @Data、@Slf4j 等）：
            框架内部按 provided 引入 Lombok，不会传递给业务工程，需自行声明。
            版本由 spring-boot-starter-parent 统一管理。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            MapStruct 注解处理器：mapstruct 运行时 jar 由框架传递，但注解处理器不随依赖传递，
            业务代码使用 @Mapper converter 时需在此显式声明。lombok-mapstruct-binding 用于
            Lombok 与 MapStruct 处理器协同（Lombok 1.18.16+ 必需）。
        -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok-mapstruct-binding</artifactId>
            <version>0.2.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                Lombok 与 MapStruct 同时使用时，处理器必须显式加入 annotationProcessorPaths：
                - Lombok 必须排在 MapStruct 之前，否则 Lombok 生成的 getter/setter 不会被 MapStruct 识别
                - lombok-mapstruct-binding 负责两者协同（Lombok 1.18.16+ 必需）
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
